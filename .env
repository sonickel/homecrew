# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> HomeCrew ###
# Master key for encrypted columns (*_enc: TOTP secret, later SMTP password, AI key): at least 32 random characters.
# Never commit it. Dev: in .env.dev.local (git-ignored), e.g. APP_ENCRYPTION_KEY=<output of: php -r "echo bin2hex(random_bytes(32));">
# Production (Pi): as Symfony secret (php bin/console secrets:set APP_ENCRYPTION_KEY --env=prod) or Docker secret.
# Back it up separately from the database – without it encrypted values cannot be read (konzept-5 §2).
APP_ENCRYPTION_KEY=
# Admins must set up a second factor (authenticator app or passkey) before they get admin rights (konzept-1 §2).
# For now 0 on request (decision 01.11.) – set to 1 before real use.
ADMIN_2FA_REQUIRED=0
# Personal logins (phone/PC) end after this many minutes without a request (decision 01.11.: 8 hours)
SESSION_IDLE_MINUTES=480
# Relying party id for passkeys (domain without port); empty = host of the request (locally: localhost)
WEBAUTHN_RP_ID=
# Home network (konzept-12 §5): the team tablet and the tablet PIN work only from these networks (comma-separated, CIDR).
# Locally loopback; on the Pi e.g. "192.168.1.0/24,fd00::/8". Requests via the tunnel never count, empty = nowhere.
HOME_NETWORKS=127.0.0.0/8,::1/128
###< HomeCrew ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=https://localhost:8000
###< symfony/routing ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
# bis M11 synchron; danach Doctrine-Transport (Tabelle messenger_messages)
MESSENGER_TRANSPORT_DSN=sync://
###< symfony/messenger ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
# Echte Zugangsdaten nur in .env.local (nie committen)
DATABASE_URL="mysql://homecrew:CHANGE_ME@127.0.0.1:3306/homecrew?serverVersion=11.8.6-MariaDB&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/lock ###
# Locks keep rate limiters and one-time codes safe against parallel requests. flock: files in the system temp dir
# (enough for one web container, locally and on the Pi)
LOCK_DSN=flock
###< symfony/lock ###
