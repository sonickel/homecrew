{
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-intl": "*",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.7",
        "easycorp/easyadmin-bundle": "^5.8",
        "endroid/qr-code": "^6.1",
        "nelmio/security-bundle": "^3.9",
        "paragonie/constant_time_encoding": "^3.1",
        "scheb/2fa-backup-code": "^8.7",
        "scheb/2fa-bundle": "^8.7",
        "spomky-labs/otphp": "^11.5",
        "symfony/asset": "7.4.*",
        "symfony/asset-mapper": "7.4.*",
        "symfony/clock": "7.4.*",
        "symfony/console": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/flex": "^2",
        "symfony/form": "7.4.*",
        "symfony/framework-bundle": "7.4.*",
        "symfony/html-sanitizer": "7.4.*",
        "symfony/mailer": "7.4.*",
        "symfony/messenger": "7.4.*",
        "symfony/monolog-bundle": "^4.1",
        "symfony/rate-limiter": "7.4.*",
        "symfony/runtime": "7.4.*",
        "symfony/scheduler": "7.4.*",
        "symfony/security-bundle": "7.4.*",
        "symfony/stimulus-bundle": "^3.6",
        "symfony/translation": "7.4.*",
        "symfony/twig-bundle": "7.4.*",
        "symfony/uid": "7.4.*",
        "symfony/ux-icons": "^3.6",
        "symfony/ux-live-component": "^3.6",
        "symfony/ux-turbo": "^3.6",
        "symfony/ux-twig-component": "^3.6",
        "symfony/validator": "7.4.*",
        "symfony/yaml": "7.4.*",
        "twig/extra-bundle": "^3.29",
        "twig/intl-extra": "^3.30",
        "web-auth/webauthn-symfony-bundle": "^5.3"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true,
            "phpstan/extension-installer": true
        },
        "bump-after-update": true,
        "sort-packages": true,
        "platform": {
            "php": "8.4.27"
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "qa": [
            "@php vendor/bin/php-cs-fixer check --diff",
            "@php bin/console lint:twig templates",
            "@php bin/console lint:yaml config --parse-tags",
            "@php bin/console lint:container",
            "@php vendor/bin/phpstan analyse --no-progress --memory-limit=1G",
            "@php bin/console cache:clear --env=test --quiet",
            "@php bin/console doctrine:migrations:migrate --env=test --no-interaction --allow-no-migration --quiet",
            "@php bin/phpunit"
        ],
        "qa:fix": [
            "@php vendor/bin/php-cs-fixer fix"
        ],
        "schema:check": [
            "@php bin/console app:schema:check"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.4.*",
            "docker": "false"
        }
    },
    "require-dev": {
        "dama/doctrine-test-bundle": "^8.7",
        "doctrine/doctrine-fixtures-bundle": "^4.3",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-doctrine": "^2.1",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpstan/phpstan-symfony": "^2.1",
        "phpunit/phpunit": "^13.4",
        "symfony/browser-kit": "7.4.*",
        "symfony/css-selector": "7.4.*",
        "symfony/debug-bundle": "7.4.*",
        "symfony/maker-bundle": "^1.68",
        "symfony/process": "7.4.*",
        "symfony/web-profiler-bundle": "7.4.*"
    },
    "scripts-descriptions": {
        "qa": "Prüft Code-Stil, Templates, YAML, Container, PHPStan, migriert die Test-Datenbank und führt PHPUnit aus (bricht beim ersten Fehler ab)",
        "qa:fix": "Korrigiert den Code-Stil automatisch",
        "schema:check": "Migriert homecrew_check von Null und vergleicht jede Tabelle mit dem Referenzschema in homecrew_smoke"
    }
}
