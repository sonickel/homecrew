{% extends 'base.html.twig' %}

{% block page_title %}{{ 'Neues Passwort'|trans }}{% endblock %}

{% block body %}
    <twig:PageHeader :title="'Neues Passwort'|trans"
        :intro="'Du hast dich mit einem Start-Passwort angemeldet. Wähle jetzt dein eigenes Passwort – nur du kennst es.'|trans" />

    {{ form_start(form, {attr: {class: 'hc-form', novalidate: 'novalidate'}}) }}
        {{ form_widget(form) }}
        <div class="hc-button-row">
            <twig:Button type="submit">{{ 'Passwort speichern'|trans }}</twig:Button>
        </div>
    {{ form_end(form) }}
{% endblock %}
