{% extends 'base.html.twig' %}

{% block page_title %}{{ 'Neues Passwort'|trans }}{% endblock %}

{% block body %}
    <twig:PageHeader :title="'Neues Passwort'|trans"
        :intro="start_password
            ? 'Du hast dich mit einem Start-Passwort angemeldet. Wähle jetzt dein eigenes Passwort – nur du kennst es.'|trans
            : 'Wähle ein neues Passwort. Auf anderen Geräten wirst du danach abgemeldet.'|trans" />

    {{ form_start(form, {attr: {class: 'hc-form', novalidate: 'novalidate'}}) }}
        {{ form_widget(form) }}
        <div class="hc-button-row">
            <twig:Button type="submit">{{ 'Passwort speichern'|trans }}</twig:Button>
            {% if not start_password %}
                <twig:Button variant="secondary" :href="path('app_account')">{{ 'Abbrechen'|trans }}</twig:Button>
            {% endif %}
        </div>
    {{ form_end(form) }}
{% endblock %}
