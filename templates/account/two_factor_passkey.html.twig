{% extends 'base.html.twig' %}

{% block page_title %}{{ 'Passkey'|trans }}{% endblock %}

{% set back_label = back == 'app_account' ? 'Abbrechen'|trans : 'Andere Methode wählen'|trans %}

{% block body %}
    <twig:PageHeader :title="back == 'app_account' ? 'Passkey hinzufügen'|trans : 'Passkey einrichten'|trans"
        :intro="'Dein Gerät speichert einen Schlüssel für HomeCrew. Zum Anmelden bestätigst du nur noch mit Fingerabdruck, Gesicht oder Geräte-PIN.'|trans" />

    {% if not passkeys_possible() %}
        {{ include('security/_passkey_unavailable.html.twig') }}
        <twig:Button variant="secondary" :href="path(back)">{{ back_label }}</twig:Button>
    {% else %}
        <div data-controller="passkey"
             data-passkey-options-url-value="{{ path('webauthn.controller.creation.request.add_passkey') }}"
             data-passkey-result-url-value="{{ path('webauthn.controller.creation.response.add_passkey') }}">
            <twig:Alert type="error" data-passkey-target="unsupported" hidden :message="'Dieser Browser kann keine Passkeys. Nimm bitte die Authenticator-App.'|trans" />
            <div class="hc-form" data-passkey-target="form" hidden>
                <div class="hc-field">
                    <label class="hc-field__label" for="passkey-label">{{ 'Name für den Passkey'|trans }}</label>
                    <p class="hc-field__help" id="passkey-label_help">{{ 'Damit du ihn später wiedererkennst, z. B. „Handy“ oder „Laptop“.'|trans }}</p>
                    <input class="hc-input" type="text" id="passkey-label" maxlength="100" aria-describedby="passkey-label_help" data-passkey-target="label">
                </div>
                <div class="hc-button-row">
                    <twig:Button icon="tabler:fingerprint" data-action="passkey#register" data-passkey-target="button">{{ 'Passkey anlegen'|trans }}</twig:Button>
                    <twig:Button variant="secondary" :href="path(back)">{{ back_label }}</twig:Button>
                </div>
                <p class="hc-passkey__message" data-passkey-target="message" role="alert" hidden></p>
            </div>
        </div>
    {% endif %}
{% endblock %}
