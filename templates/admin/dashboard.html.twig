{% extends '@EasyAdmin/page/content.html.twig' %}

{% block page_title %}{{ 'Verwaltung'|trans }}{% endblock %}
{% block content_title %}{{ 'Verwaltung'|trans }}{% endblock %}

{% block main %}
    <p>{{ 'Hier stellst du den Haushalt ein und siehst das Protokoll. Weitere Bereiche wie Personen, Geräte und Notfall-Infos kommen mit den nächsten Ausbaustufen dazu.'|trans }}</p>
    <ul>
        <li><a href="{{ ea_url().setController('App\\Controller\\Admin\\GeneralSettingsCrudController').setAction('edit').setEntityId(1) }}">{{ 'Einstellungen: Allgemein'|trans }}</a> – {{ 'Haushaltsname, Zeitzone, Feiertage, Tablet und Videos'|trans }}</li>
        <li><a href="{{ ea_url().setController('App\\Controller\\Admin\\RetentionSettingsCrudController').setAction('edit').setEntityId(1) }}">{{ 'Einstellungen: Löschfristen'|trans }}</a> – {{ 'wann alte Daten automatisch gelöscht werden'|trans }}</li>
        <li><a href="{{ ea_url().setController('App\\Controller\\Admin\\AuditLogCrudController').setAction('index') }}">{{ 'Protokoll'|trans }}</a> – {{ 'Anmeldungen und Änderungen an Einstellungen'|trans }}</li>
    </ul>
    <p>{{ 'Zum Abmelden gehst du links im Menü zurück zu „Heute" und tippst dort oben rechts auf „Abmelden".'|trans }}</p>
{% endblock %}
