{% extends 'form_div_layout.html.twig' %}

{# One field per row: label above, hint below the label, error with symbol and word (never colour alone) #}
{%- block form_row -%}
    {#- Screen readers read hint and errors together with the field -#}
    {%- set described_by = [] -%}
    {%- if help is not empty -%}{%- set described_by = described_by|merge([id ~ '_help']) -%}{%- endif -%}
    {%- if errors|length > 0 -%}{%- set described_by = described_by|merge([id ~ '_errors']) -%}{%- endif -%}
    {%- set widget_attr = described_by is empty ? {} : {attr: {'aria-describedby': described_by|join(' ')}} -%}
    <div class="hc-field{{ errors|length > 0 ? ' hc-field--error' }}">
        {{- form_label(form) -}}
        {{- form_help(form) -}}
        {{- form_errors(form) -}}
        {{- form_widget(form, widget_attr) -}}
    </div>
{%- endblock form_row -%}

{#- Radio buttons and checkboxes: the whole row is the touch target (.hc-option__row) -#}
{%- block choice_row -%}
    {%- if expanded -%}
        <fieldset class="hc-option{{ errors|length > 0 ? ' hc-field--error' }}"{% if help is not empty %} aria-describedby="{{ id }}_help"{% endif %}>
            <legend class="hc-field__label">{{ label|trans(label_translation_parameters, translation_domain) }}</legend>
            {{- form_help(form) -}}
            {{- form_errors(form) -}}
            {%- for child in form -%}
                <label class="hc-option__row">{{ form_widget(child) }}<span>{{ child.vars.label|trans(child.vars.label_translation_parameters, choice_translation_domain) }}</span></label>
            {%- endfor -%}
        </fieldset>
    {%- else -%}
        {{- block('form_row') -}}
    {%- endif -%}
{%- endblock choice_row -%}

{%- block checkbox_row -%}
    <div class="hc-option">
        {{- form_errors(form) -}}
        <label class="hc-option__row">{{ form_widget(form) }}<span>{{ label|trans(label_translation_parameters, translation_domain) }}</span></label>
        {{- form_help(form) -}}
    </div>
{%- endblock checkbox_row -%}

{%- block repeated_row -%}
    {{- block('form_rows') -}}
{%- endblock repeated_row -%}

{%- block form_label_class -%}hc-field__label{%- endblock -%}

{%- block form_label -%}
    {%- set label_attr = label_attr|merge({class: (label_attr.class|default('') ~ ' hc-field__label')|trim}) -%}
    {{- parent() -}}
{%- endblock form_label -%}

{%- block form_help -%}
    {%- if help is not empty -%}
        <p id="{{ id }}_help" class="hc-field__help">{{ help|trans(help_translation_parameters, translation_domain) }}</p>
    {%- endif -%}
{%- endblock form_help -%}

{%- block form_errors -%}
    {%- if errors|length > 0 -%}
        <ul class="hc-field__errors" id="{{ id }}_errors">
            {%- for error in errors -%}
                <li>{{ ux_icon('tabler:alert-circle', {'aria-hidden': 'true'}) }}<span>{{ error.message }}</span></li>
            {%- endfor -%}
        </ul>
    {%- endif -%}
{%- endblock form_errors -%}

{%- block widget_attributes -%}
    {#- Text fields get the field look; checkboxes and radio buttons are styled by their option row (.hc-option) -#}
    {%- if 'checkbox' not in block_prefixes and 'radio' not in block_prefixes -%}
        {%- set attr = attr|merge({class: (attr.class|default('') ~ ' hc-input')|trim}) -%}
    {%- endif -%}
    {%- if errors|length > 0 -%}
        {%- set attr = attr|merge({'aria-invalid': 'true'}) -%}
    {%- endif -%}
    {{- parent() -}}
{%- endblock widget_attributes -%}
