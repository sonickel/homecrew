{# One plan as a row (App\Service\Task\PlanRow): status with symbol and word, title linking to the plan, details;
   "Zuletzt erledigt" only as the day – admins also see who it was (konzept-12 §6) #}
{% set status = plan_status(row) %}
{% set plan = row.plan %}
<li class="hc-task hc-task--{{ status.modifier }}">
    <div class="hc-task__main">
        <p class="hc-task__when hc-status hc-status--{{ status.modifier }}">{{ ux_icon(status.icon, {'aria-hidden': 'true'}) }}<span>{{ status.text }}</span></p>
        <a class="hc-task__title" href="{{ path('app_plan_show', {id: plan.id}) }}">{{ plan.title }}</a>
        <ul class="hc-task__details">
            {% if row.openReport %}<li class="hc-task__important">{{ ux_icon('tabler:speakerphone', {'aria-hidden': 'true'}) }}<span>{{ 'Meldung offen'|trans }}</span></li>{% endif %}
            <li>{{ plan_rhythm(plan) }}</li>
            <li>{{ 'Zuständig: %name%'|trans({'%name%': task_assignee(plan)|trans}) }}</li>
            <li>
                {%- if plan.lastDoneAt -%}
                    {{ 'Zuletzt erledigt: %day%'|trans({'%day%': plan.lastDoneAt|format_date(pattern: 'd. MMMM yyyy', locale: 'de')}) }}
                    {%- if row.lastDone %} {{ include('plan/_by.html.twig', {completion: row.lastDone}) }}{% endif -%}
                {%- else -%}
                    {{ 'Noch nie erledigt'|trans }}
                {%- endif -%}
            </li>
        </ul>
    </div>
</li>
