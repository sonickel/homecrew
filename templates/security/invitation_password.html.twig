{% extends 'base.html.twig' %}

{% block page_title %}{{ 'Einladung'|trans }}{% endblock %}

{% block body %}
    <twig:PageHeader :title="'Hallo %name%'|trans({'%name%': person.displayName})"
        :intro="'Wähle jetzt dein Passwort für HomeCrew – nur du kennst es.'|trans" />

    <p>{{ 'Dein Benutzername:'|trans }} <strong>{{ person.username }}</strong>. {{ 'Den brauchst du später zum Anmelden.'|trans }}</p>

    {{ form_start(form, {attr: {class: 'hc-form', novalidate: 'novalidate'}}) }}
        {# Lets password managers store username and password together #}
        <input class="hc-visually-hidden" type="text" name="benutzername" value="{{ person.username }}" autocomplete="username" readonly tabindex="-1" aria-hidden="true">
        {{ form_widget(form) }}
        <div class="hc-button-row">
            <twig:Button type="submit">{{ 'Passwort speichern'|trans }}</twig:Button>
        </div>
    {{ form_end(form) }}
{% endblock %}
