{# id + data-turbo-permanent: the regular reload of "Heute" (Turbo morph) leaves the layer as it is #}
{# Screensaver of the team tablet (konzept-12 §5): covers the page after the idle time; emergency numbers stay reachable.
   Only contacts for everybody that are marked for the lock screen (lockscreen_contacts()). #}
<div id="bildschirmschoner" class="hc-screensaver" data-turbo-permanent data-screensaver-target="overlay" data-action="click->screensaver#wake keydown->screensaver#wakeByKey" tabindex="-1" hidden
     role="dialog" aria-modal="true" aria-label="{{ 'Bildschirmschoner'|trans }}">
    <p class="hc-screensaver__time" data-screensaver-target="clock"></p>
    <p class="hc-screensaver__date" data-screensaver-target="date"></p>
    <a class="hc-emergency-button hc-emergency-button--large" href="tel:112">{{ ux_icon('tabler:phone', {'aria-hidden': 'true'}) }}<span>{{ 'Notruf 112'|trans }}</span></a>
    {% set contacts = lockscreen_contacts() %}
    {% if contacts is not empty %}
        <ul class="hc-screensaver__contacts">
            {% for contact in contacts %}
                <li>
                    <a class="hc-screensaver__contact" href="tel:{{ contact.phoneDial }}">
                        <span class="hc-screensaver__name">{{ contact.name }}{% if contact.relation %} ({{ contact.relation }}){% endif %}</span>
                        <span>{{ contact.phone }}</span>
                    </a>
                    {% if contact.whenToCall %}<p class="hc-screensaver__when">{{ contact.whenToCall }}</p>{% endif %}
                </li>
            {% endfor %}
        </ul>
    {% endif %}
    <p class="hc-screensaver__hint">{{ 'Zum Weiterarbeiten antippen.'|trans }}</p>
</div>
