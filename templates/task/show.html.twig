{% extends 'base.html.twig' %}

{% block page_title %}{{ task.title }}{% endblock %}

{% block body %}
    {% set status = task_status(task) %}
    <twig:PageHeader :title="task.title">
        <p class="hc-status hc-status--{{ status.modifier }} hc-text-1">{{ ux_icon(status.icon, {'aria-hidden': 'true'}) }}<span>{{ status.text }}</span></p>
    </twig:PageHeader>

    {% set checklist = task.open and task.items is not empty and is_granted('TASK_ACT', task) %}
    {% if task.open %}
        <div class="hc-button-row">
            {% if is_granted('TASK_ACT', task) %}
                {# With a checklist "Erledigt" is below the points #}
                {% if not checklist %}
                    <form method="post" action="{{ path('app_task_complete', {id: task.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('submit') }}" data-controller="csrf-protection">
                        <twig:Button type="submit" icon="tabler:check">{{ 'Erledigt'|trans }}</twig:Button>
                    </form>
                {% endif %}
                <form method="post" action="{{ path('app_task_skip', {id: task.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('submit') }}" data-controller="csrf-protection">
                    <twig:Button type="submit" variant="secondary" icon="tabler:player-skip-forward">{{ 'Überspringen'|trans }}</twig:Button>
                </form>
                <twig:Button variant="secondary" icon="tabler:calendar-event" :href="path('app_task_postpone', {id: task.id})">{{ 'Verschieben'|trans }}</twig:Button>
                <twig:Button variant="secondary" icon="tabler:circle-x" :href="path('app_task_unable', {id: task.id})">{{ 'Nicht möglich'|trans }}</twig:Button>
            {% endif %}
            {% if is_granted('TASK_HANDOVER', task) %}
                <twig:Button variant="secondary" icon="tabler:arrow-forward-up" :href="path('app_task_handover', {id: task.id})">{{ 'Weitergeben'|trans }}</twig:Button>
            {% endif %}
            {% if is_granted('TASK_EDIT', task) %}
                <twig:Button variant="secondary" icon="tabler:pencil" :href="path('app_task_edit', {id: task.id})">{{ 'Bearbeiten'|trans }}</twig:Button>
            {% endif %}
        </div>
    {% endif %}

    {% if task.description %}
        <div class="hc-prose hc-task-description">{{ task.description|nl2br }}</div>
    {% endif %}

    {% if task.items is not empty %}
        <section class="hc-section" aria-labelledby="checkliste">
            <h2 id="checkliste">{{ 'Checkliste'|trans }}</h2>
            {% if checklist %}
                {# Tick off what was done – "Erledigt" saves the ticks (a tap on "Heute" ticks off every point) #}
                <form class="hc-form" method="post" action="{{ path('app_task_complete', {id: task.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('submit') }}" data-controller="csrf-protection">
                    <input type="hidden" name="checkliste" value="1">
                    <fieldset class="hc-option">
                        <legend class="hc-visually-hidden">{{ 'Was ist erledigt?'|trans }}</legend>
                        {% for item in task.items %}
                            <label class="hc-option__row"><input type="checkbox" name="punkte[]" value="{{ item.id }}"><span>{{ item.label }}</span></label>
                        {% endfor %}
                    </fieldset>
                    <twig:Button type="submit" icon="tabler:check">{{ 'Erledigt'|trans }}</twig:Button>
                </form>
            {% else %}
                <ul class="hc-checklist">
                    {% for item in task.items %}
                        {% if completion and completion.isChecked(item) %}
                            <li>{{ ux_icon('tabler:square-check', {'aria-hidden': 'true'}) }}<span><span class="hc-visually-hidden">{{ 'Abgehakt:'|trans }} </span>{{ item.label }}</span></li>
                        {% else %}
                            <li>{{ ux_icon('tabler:square', {'aria-hidden': 'true'}) }}<span><span class="hc-visually-hidden">{{ completion ? 'Nicht abgehakt:'|trans : 'Offen:'|trans }} </span>{{ item.label }}</span></li>
                        {% endif %}
                    {% endfor %}
                </ul>
            {% endif %}
        </section>
    {% endif %}

    <dl class="hc-facts">
        {% if task.template and is_granted('PLAN_VIEW', task.template) %}
            <dt>{{ 'Gehört zu'|trans }}</dt>
            <dd><a href="{{ path('app_plan_show', {id: task.template.id}) }}">{{ task.template.title }}</a> ({{ plan_rhythm(task.template) }})</dd>
        {% endif %}
        <dt>{{ 'Fällig'|trans }}</dt>
        <dd>{{ task_due(task) }}</dd>
        {% if task.open %}
            <dt>{{ 'Erscheint'|trans }}</dt>
            <dd>{{ task_show_from(task) }}</dd>
        {% endif %}
        <dt>{{ 'Zuständig'|trans }}</dt>
        <dd>{{ task_assignee(task)|trans }}</dd>
        <dt>{{ 'Wer sieht sie'|trans }}</dt>
        <dd>{{ task.visibility.label|trans }}</dd>
        <dt>{{ 'Kategorie'|trans }}</dt>
        <dd>{{ task.category.label|trans }}</dd>
        {% if task.estimatedMinutes %}
            <dt>{{ 'Dauer'|trans }}</dt>
            <dd>{{ 'ca. %minutes% Minuten'|trans({'%minutes%': task.estimatedMinutes}) }}</dd>
        {% endif %}
        {% if task.important %}
            <dt>{{ 'Wichtig'|trans }}</dt>
            <dd>{{ 'Ja'|trans }}</dd>
        {% endif %}
        {% if task.requiresManager %}
            <dt>{{ 'Gemeinsam mit'|trans }}</dt>
            <dd>{{ with_manager() }}</dd>
        {% endif %}
        {% if task.postponedCount > 0 %}
            <dt>{{ 'Verschoben'|trans }}</dt>
            <dd>{{ task.postponedCount == 1 ? 'einmal'|trans : '%count%-mal'|trans({'%count%': task.postponedCount}) }}</dd>
        {% endif %}
        {# Who did what: only admins (konzept-12 §6) – the person, or "am Team-Tablet" #}
        {% if admin and task.assignedAt %}
            <dt>{{ 'Weitergegeben'|trans }}</dt>
            <dd>
                {{- task.assignedAt|format_datetime(pattern: "d. MMMM yyyy, HH:mm 'Uhr'", locale: 'de') }}
                {% if task.assignedBy %}{{ 'von %name%'|trans({'%name%': task.assignedBy.displayName}) }}{% elseif task.assignedByDevice %}{{ 'am Team-Tablet'|trans }}{% endif -%}
            </dd>
        {% endif %}
        {% if admin %}
            <dt>{{ 'Angelegt'|trans }}</dt>
            <dd>
                {{- task.createdAt|format_datetime(pattern: "d. MMMM yyyy, HH:mm 'Uhr'", locale: 'de') }}
                {% if task.createdBy %}{{ 'von %name%'|trans({'%name%': task.createdBy.displayName}) }}{% endif -%}
            </dd>
        {% endif %}
        {% if report and is_granted('REPORT_VIEW', report) %}
            <dt>{{ 'Gemeldet'|trans }}</dt>
            <dd>
                {%- if is_granted('REPORT_MANAGE', report) -%}
                    <a href="{{ path('app_report_show', {publicId: report.publicId.toRfc4122}) }}">{{ report.title }}</a>
                {%- else -%}
                    {{ report.title }}
                {%- endif %} ({{ report_status(report).text }})
            </dd>
        {% endif %}
        {% if completion %}
            <dt>{{ completion.action.label|capitalize|trans }}</dt>
            <dd>
                {# For everybody only the date (konzept-12 §6) – time and person only for admins #}
                {{- admin ? completion.doneAt|format_datetime(pattern: "d. MMMM yyyy, HH:mm 'Uhr'", locale: 'de') : completion.doneAt|format_date(pattern: 'd. MMMM yyyy', locale: 'de') }}
                {% if admin %}{% if completion.user %}{{ 'von %name%'|trans({'%name%': completion.user.displayName}) }}{% elseif completion.device %}{{ 'am Team-Tablet'|trans }}{% endif %}{% endif -%}
            </dd>
        {% endif %}
    </dl>

    <div class="hc-button-row">
        <twig:Button variant="secondary" icon="tabler:arrow-left" :href="path('app_home')">{{ 'Zurück zu Heute'|trans }}</twig:Button>
    </div>
{% endblock %}
